## Docker Environment Variables
NODE_ENV=production

## ─────────────────────────────────────────────────────────────────────────
## SWITCH del modo del puente (consumido por docker-compose)
##   true  → flujo ZK   (ReceiverZK.release() verifica una prueba on-chain)
##   false → flujo clásico (Receiver.mintRemote(), relayer de confianza)
## Requisito para true: haber corrido `npm run circuits:mpt` una vez
## (genera contracts/verifiers/TxInclusionVerifier.sol y circuits/mpt/*.json).
ENABLE_ZK_PROOF_WAY=false

## RPC de N1/N2 — los lee relayer.js/relayer-zk.js (y npx hardhat test).
## En Docker, docker-compose.yml los pisa con los hostnames internos
## (hardhat-n1/anvil-n2); estos valores son para correr en el host (npm run
## relayer(:zk), npx hardhat test).
RPC_URL_N1=http://127.0.0.1:8545
RPC_URL_N2=http://127.0.0.1:9545

## Red externa (producción/testnet) — no usado en local/Docker.
# RPC_URL_N1=wss://sepolia.infura.io/ws/v3/<YOUR_KEY>
# RPC_URL_N2=https://optimism-sepolia.infura.io/v3/<YOUR_KEY>

## Private Keys
PRIVATE_KEY_DEPLOYER=0xac0974bec39a17e36ba4a6b4d238ff944bacb476c6b8d6c1f02cb9433d8986625
PRIVATE_KEY_RELAYER=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

## Relayer Configuration
RELAYER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
START_BLOCK_N1=0

## Logging
LOG_LEVEL=info

## Contract Addresses (auto-populated after deployment)
# GUARANI_TOKEN_ADDRESS=
# SENDER_ADDRESS=
# RECEIVER_ADDRESS=
